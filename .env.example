# Set these values before an internet-facing deployment. If ADMIN_PASSWORD is blank,
# the first run generates a high-entropy password and writes it once to the console log.
SECRET_KEY=
ADMIN_EMAIL=admin@rijoya.local
ADMIN_PASSWORD=
STORE_NAME=Rijoya
COOKIE_SECURE=0
# Optional; default is the local SQLite file ./database.db
# DATABASE_URL=sqlite:///database.db
